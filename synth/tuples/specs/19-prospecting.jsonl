{"id": "19-01", "agent": "19", "tuple": "(representation status unclear, mark unknown with source; the human decides posture)", "route": "intake", "lines": [{"do": "config", "to": "19", "ctx": "setup", "payload": {"zip_codes": ["44101"]}}, {"do": "config", "to": "19", "ctx": "setup", "payload": {"approved_sources": ["mls-expired-feed", "fsbo-portal-licensed"]}}, {"do": "send", "from": "external", "to": "19", "intent": "discovery.feed", "ctx": "P1", "payload": {"listing_id": "P1", "zip_code": "44101", "source": "mls-expired-feed", "status": "new", "today": "2026-10-15", "price": 420000, "beds": 3, "representation_status": "maybe still listed?"}}], "expect": [{"kind": "envelope.persisted", "intent": "prospect.opportunity", "ctx": "P1", "contains_all": ["\"representation_status\": \"unknown\"", "\"source\": \"mls-expired-feed\""]}]}
