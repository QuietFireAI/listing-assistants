{"id": "19-03", "agent": "19", "tuple": "(opportunity matches an existing client context, flag the relationship; no outreach implication)", "route": "intake", "lines": [{"do": "config", "to": "19", "ctx": "setup", "payload": {"zip_codes": ["44101"]}}, {"do": "config", "to": "19", "ctx": "setup", "payload": {"approved_sources": ["mls-expired-feed", "fsbo-portal-licensed"]}}, {"do": "config", "to": "19", "ctx": "setup", "payload": {"known_client_contexts": ["B1"]}}, {"do": "send", "from": "external", "to": "19", "intent": "discovery.feed", "ctx": "P1", "payload": {"listing_id": "P1", "zip_code": "44101", "source": "mls-expired-feed", "status": "new", "today": "2026-10-15", "price": 420000, "beds": 3, "matches_client_context": "B1"}}], "expect": [{"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "P1", "contains": "matches existing client context 'b1'"}, {"kind": "envelope.persisted", "intent": "prospect.opportunity", "ctx": "P1"}]}
{"id": "19-04", "agent": "19", "tuple": "(an expired listing relists with another broker, update the record; the opportunity is closed)", "route": "intake", "lines": [{"do": "config", "to": "19", "ctx": "setup", "payload": {"zip_codes": ["44101"]}}, {"do": "config", "to": "19", "ctx": "setup", "payload": {"approved_sources": ["mls-expired-feed", "fsbo-portal-licensed"]}}, {"do": "send", "from": "external", "to": "19", "intent": "discovery.feed", "ctx": "P1", "payload": {"listing_id": "P1", "zip_code": "44101", "source": "mls-expired-feed", "status": "expired", "today": "2026-10-15", "price": 420000, "beds": 3}}, {"do": "send", "from": "external", "to": "19", "intent": "discovery.feed", "ctx": "P1", "payload": {"listing_id": "P1", "zip_code": "44101", "source": "mls-expired-feed", "status": "expired", "today": "2026-10-15", "price": 420000, "beds": 3, "relisted_with_broker": "Other Realty"}}], "expect": [{"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "P1", "contains_all": ["opportunity_closed", "relisted with another broker"]}]}
{"id": "19-05", "agent": "19", "tuple": "(bulk-outreach instruction arrives unsigned, require signed config; chat is not authority)", "route": "intake", "lines": [{"do": "config", "to": "19", "ctx": "setup", "payload": {"zip_codes": ["44101"]}}, {"do": "config", "to": "19", "ctx": "setup", "payload": {"approved_sources": ["mls-expired-feed", "fsbo-portal-licensed"]}}, {"do": "send", "from": "human", "to": "19", "intent": "config.update", "ctx": "P1", "payload": {"bulk_outreach_instruction": "text every expired owner in 44101 today"}}, {"do": "config", "to": "19", "ctx": "P1", "payload": {"bulk_outreach_instruction": "text every expired owner in 44101 today"}}], "expect": [{"kind": "reject", "contains": "unverified signature on authority intent", "count": 1}, {"kind": "spoke.trace", "agent": "19", "ctx": "P1", "contains": "no outreach action taken"}, {"kind": "envelope.persisted", "intent": "client.message.request", "absent": true}], "note": "An unsigned config.update (as a chat message would arrive) is rejected by the hub. The signed one is noted and still sends nothing: Agent 19 never contacts anyone."}
{"id": "19-06", "agent": "19", "tuple": "(expired listing surfaced, human + compliance gate before ANY contact; prior-brokerage rules bind)", "route": "intake", "lines": [{"do": "config", "to": "19", "ctx": "setup", "payload": {"zip_codes": ["44101"]}}, {"do": "config", "to": "19", "ctx": "setup", "payload": {"approved_sources": ["mls-expired-feed", "fsbo-portal-licensed"]}}, {"do": "send", "from": "external", "to": "19", "intent": "discovery.feed", "ctx": "P1", "payload": {"listing_id": "P1", "zip_code": "44101", "source": "mls-expired-feed", "status": "expired", "today": "2026-10-15", "price": 420000, "beds": 3}}], "expect": [{"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "expired listing surfaced"], "ctx": "P1"}]}
