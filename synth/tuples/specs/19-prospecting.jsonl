{"id": "19-10", "agent": "19", "tuple": "(neighbor data requested for farm outreach, aggregate level only; individual household inferences refused)", "route": "intake", "lines": [{"do": "config", "to": "19", "ctx": "setup", "payload": {"zip_codes": ["44101"]}}, {"do": "config", "to": "19", "ctx": "setup", "payload": {"approved_sources": ["mls-expired-feed", "fsbo-portal-licensed"]}}, {"do": "config", "to": "19", "ctx": "F1", "payload": {"farm_data_request": {"zip": "44101", "individual_level": true}}}, {"do": "config", "to": "19", "ctx": "F2", "payload": {"farm_data_request": {"zip": "44101"}}}], "expect": [{"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "individual household-level"], "ctx": "F1"}, {"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "F2", "contains": "no neighborhood data source connected"}, {"kind": "envelope.persisted", "intent": "data.request", "absent": true}], "note": "Owner decision D-A16 (2026-10-28): no neighborhood data source is connected, so an aggregate request is answered with that, once; Agent 19 no longer sends Agent 10 an empty request."}
