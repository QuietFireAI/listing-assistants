{"id": "15-01", "agent": "15", "tuple": "(recorded figure differs from contract language, escalate with the clause verbatim)", "route": "intake", "lines": [{"do": "config", "to": "15", "ctx": "T1", "payload": {"commission_dispute": {"recorded": 36000, "contract_figure": 27000, "contract_clause": "Seller shall pay a total commission of 6% of the sale price at closing."}}}], "expect": [{"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "36000", "seller shall pay a total commission of 6% of the sale price at closing."], "ctx": "T1"}]}
{"id": "15-02", "agent": "15", "tuple": "(expense fits two categories with different tax flags, flag both; the accountant decides)", "route": "intake", "lines": [{"do": "config", "to": "15", "ctx": "T1", "payload": {"add_expense": {"description": "Home office internet", "amount": 90, "categories": ["office", "utilities"], "tax_flags": ["deductible_100", "deductible_partial"], "receipt_on_file": true}}}, {"do": "config", "to": "15", "ctx": "T1", "payload": {"generate_pnl": {"months": ["2026-10"]}}}], "expect": [{"kind": "spoke.trace", "agent": "15", "ctx": "T1", "contains": "flagged: dual_category_tax_conflict"}, {"kind": "envelope.persisted", "intent": "report.package", "ctx": "T1", "contains_all": ["\"dual_category_tax_conflict\": true", "deductible_partial"]}]}
{"id": "15-03", "agent": "15", "tuple": "(ROI attribution claimed by two sources, report both claims)", "route": "intake", "lines": [{"do": "config", "to": "15", "ctx": "T1", "payload": {"roi_claim": {"attribution_key": "T1-sale", "source": "facebook_ads", "value": 12000}}}, {"do": "config", "to": "15", "ctx": "T1", "payload": {"roi_claim": {"attribution_key": "T1-sale", "source": "past_client_referral", "value": 12000}}}], "expect": [{"kind": "envelope.persisted", "intent": "report.package", "ctx": "T1", "contains_all": ["roi_conflict", "facebook_ads", "past_client_referral"], "count": 1}]}
{"id": "15-04", "agent": "15", "tuple": "(a month of data is missing, label it missing; never interpolate)", "route": "intake", "lines": [{"do": "config", "to": "15", "ctx": "T1", "payload": {"data_month_received": "2026-08"}}, {"do": "config", "to": "15", "ctx": "T1", "payload": {"generate_pnl": {"months": ["2026-08", "2026-09"]}}}], "expect": [{"kind": "envelope.persisted", "intent": "report.package", "ctx": "T1", "contains": "\"missing_months\": [\"2026-09\"]"}]}
{"id": "15-05", "agent": "15", "tuple": "(any commission-language question, escalation.legal_line)", "route": "intake", "lines": [{"do": "config", "to": "15", "ctx": "T1", "payload": {"commission_language_question": "Does the co-op split in paragraph 4 apply to a dual agency sale?"}}], "expect": [{"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "co-op split in paragraph 4"], "ctx": "T1"}]}
{"id": "15-06", "agent": "15", "tuple": "(commission math depends on an unsigned amendment, compute on signed docs only; projection labeled as such)", "route": "intake", "lines": [{"do": "config", "to": "07", "ctx": "T1", "payload": {"timeline_init": {"closing": "2026-10-20"}, "today": "2026-10-15"}}, {"do": "config", "to": "08", "ctx": "T1", "payload": {"expected_senders": {"closing_settlement_statement": ["party@example.test"]}}}, {"do": "send", "from": "external", "to": "11", "intent": "client.reply", "ctx": "T1", "payload": {"message": "closing_settlement_statement attached", "document_attached": true, "doc_type": "closing_settlement_statement", "submitting_party": "party@example.test", "content_hash": "sha256-closing_settlement_statement-T1", "opens_correctly": true, "today": "2026-10-15", "sale_price": 450000, "signed": false}}, {"do": "config", "to": "15", "ctx": "T1", "payload": {"generate_pnl": {"months": ["2026-10"]}}}], "expect": [{"kind": "envelope.persisted", "intent": "transaction.closed", "ctx": "T1", "contains": "\"signed_docs_only\": false"}, {"kind": "envelope.persisted", "intent": "report.package", "ctx": "T1", "contains_all": ["projection - unsigned amendment", "36000", "computed_at_default_rate_0.08"]}], "note": "The settlement statement arrives unsigned: the commission (8% default rate on 450000) is kept, labeled a projection."}
{"id": "15-07", "agent": "15", "tuple": "(expense without receipt artifact, recorded as unverified; never promoted to verified by time)", "route": "intake", "lines": [{"do": "config", "to": "15", "ctx": "T1", "payload": {"add_expense": {"description": "Open house signs", "amount": 140, "categories": ["marketing"], "tax_flags": ["deductible_100"], "receipt_on_file": false}}}, {"do": "sweep", "today": "2026-11-30", "now_iso": "2026-11-30T10:00:00"}, {"do": "config", "to": "15", "ctx": "T1", "payload": {"generate_pnl": {"months": ["2026-10"]}}}], "expect": [{"kind": "envelope.persisted", "intent": "report.package", "ctx": "T1", "contains_all": ["open house signs", "\"verified\": false"]}]}
{"id": "15-08", "agent": "15", "tuple": "(pipeline value requested including UNKNOWN-tier leads, exclude them, note the exclusion; unknowns are not value)", "route": "intake", "lines": [{"do": "config", "to": "15", "ctx": "T1", "payload": {"pipeline_value_request": {"leads": [{"ctx": "A", "tier": "HOT", "value": 20000}, {"ctx": "B", "tier": "WARM", "value": 10000}, {"ctx": "C", "tier": "UNKNOWN", "value": 50000}]}}}], "expect": [{"kind": "envelope.persisted", "intent": "report.package", "ctx": "T1", "contains_all": ["\"total\": 30000", "\"excluded_unknown_count\": 1", "unknowns are not value"]}]}
{"id": "15-09", "agent": "15", "tuple": "(disbursement instruction arrives by email, wire-adjacent, full stop legal line; voice-verified human process only)", "route": "intake", "lines": [{"do": "config", "to": "15", "ctx": "T1", "payload": {"forwarded_email": "Disbursement instruction from the title company: please wire the funds to the new account below."}}], "expect": [{"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "disbursement instruction received", "voice-verified"], "ctx": "T1"}], "note": "The broker passes the email to Agent 15 as a signed setting, the only way text reaches it."}
{"id": "15-10", "agent": "15", "tuple": "(forecast requested past data horizon, decline the horizon, deliver what data supports)", "route": "intake", "lines": [{"do": "config", "to": "15", "ctx": "T1", "payload": {"forecast_request": {"horizon_months": 12, "data_horizon_months": 6}}}, {"do": "config", "to": "15", "ctx": "T1", "payload": {"forecast_request": {"data_horizon_months": 6}}}], "expect": [{"kind": "envelope.persisted", "intent": "report.package", "ctx": "T1", "contains_all": ["\"declined_horizon\": 12", "\"delivered_horizon\": 6"]}, {"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "forecast_request needs horizon_months"}], "note": "Second line: a request with no horizon now gets a clarification (it raised an error before 2026-10-14)."}
