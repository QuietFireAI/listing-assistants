{"id": "12-10", "agent": "12", "tuple": "(budget change requested verbally, current signed budget stands until config.update)", "route": "intake", "lines": [{"do": "config", "to": "12", "ctx": "T1", "payload": {"signed_budget": 500}}, {"do": "config", "to": "12", "ctx": "T1", "payload": {"budget_change_verbal": "seller said go to 800"}}], "expect": [{"kind": "spoke.trace", "agent": "12", "ctx": "T1", "contains": "signed_budget_stands"}], "note": "A verbal change reported through a config.update is logged and ignored; only a signed_budget figure changes the budget."}
