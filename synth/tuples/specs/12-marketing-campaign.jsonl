{"id": "12-07", "agent": "12", "tuple": "(fair-housing verdict pending, nothing publishes; verdict is a gate not a race)", "route": "intake", "setup_skip": ["17"], "lines": [{"do": "config", "to": "14", "ctx": "T1", "payload": {"consent_record": {"email": "yes", "text": "yes"}}}, {"do": "authorize", "to": "05", "ctx": "T1", "payload": {"new_listing": {"address": "T1 Synthetic Ln, Testville, OH", "seller_name": "Seller T1-Synth", "beds": 3, "baths": 2, "sqft_tax_record": 1800, "price": 450000, "features": ["garage"]}, "authorize_go_live": true, "today": "2026-10-15"}}, {"do": "release", "ctx": "T1", "intent": "vendor.schedule"}, {"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"kind": "photography", "event_kind": "deliverable_report", "doc_type": "photo_package", "proof_artifact_present": true, "content_hash": "sha256-photo-T1"}}, {"do": "config", "to": "12", "ctx": "T1", "payload": {"new_campaign": {"headline": "Open house Sunday", "body": "Bright kitchen near the park", "platform": "facebook"}, "today": "2026-10-15"}}], "expect": [{"kind": "envelope.persisted", "intent": "content.review", "ctx": "T1", "contains": "bright kitchen"}, {"kind": "envelope.persisted", "intent": "content.verdict", "ctx": "T1", "absent": true}, {"kind": "human.notified", "intent": "campaign.publish", "absent": true}], "note": "No compliance ruleset loaded, so Agent 17 returns no verdict: both the listing asset and the campaign wait, and nothing publishes."}
{"id": "12-08", "agent": "12", "tuple": "(campaign targets a geography, farm rules apply; demographic targeting parameters are refused outright)", "route": "intake", "lines": [{"do": "config", "to": "12", "ctx": "T1", "payload": {"new_campaign": {"headline": "Open house Sunday", "body": "Bright kitchen near the park", "platform": "facebook", "targeting_demographic": {"age_range": "25-40"}}, "today": "2026-10-15"}}], "expect": [{"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "demographic targeting"], "ctx": "T1"}, {"kind": "envelope.persisted", "intent": "content.review", "ctx": "T1", "absent": true}]}
