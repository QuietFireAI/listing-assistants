{"id": "12-01", "agent": "12", "tuple": "(approved asset needs platform truncation, truncation is an edit; back through 17)", "route": "intake", "lines": [{"do": "config", "to": "14", "ctx": "T1", "payload": {"consent_record": {"email": "yes", "text": "yes"}}}, {"do": "authorize", "to": "05", "ctx": "T1", "payload": {"new_listing": {"address": "T1 Synthetic Ln, Testville, OH", "seller_name": "Seller T1-Synth", "beds": 3, "baths": 2, "sqft_tax_record": 1800, "price": 450000, "features": ["garage"]}, "authorize_go_live": true, "today": "2026-10-15"}}, {"do": "release", "ctx": "T1", "intent": "vendor.schedule"}, {"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"kind": "photography", "event_kind": "deliverable_report", "doc_type": "photo_package", "proof_artifact_present": true, "content_hash": "sha256-photo-T1"}}, {"do": "send", "from": "external", "to": "12", "intent": "platform.metrics", "ctx": "T1", "payload": {"event_kind": "truncated", "platform": "facebook", "truncated_content": {"body": "3 bedrooms, 2 bathrooms, 1800 sq ft..."}, "today": "2026-10-15"}}], "expect": [{"kind": "envelope.persisted", "intent": "content.review", "ctx": "T1", "contains_all": ["truncation is an edit", "1800 sq ft..."]}, {"kind": "spoke.trace", "agent": "12", "ctx": "T1", "contains": "back through 17"}]}
{"id": "12-02", "agent": "12", "tuple": "(platform rejects an ad, log the raw rejection + human; never tweak targeting to pass a filter)", "route": "intake", "lines": [{"do": "config", "to": "14", "ctx": "T1", "payload": {"consent_record": {"email": "yes", "text": "yes"}}}, {"do": "authorize", "to": "05", "ctx": "T1", "payload": {"new_listing": {"address": "T1 Synthetic Ln, Testville, OH", "seller_name": "Seller T1-Synth", "beds": 3, "baths": 2, "sqft_tax_record": 1800, "price": 450000, "features": ["garage"]}, "authorize_go_live": true, "today": "2026-10-15"}}, {"do": "release", "ctx": "T1", "intent": "vendor.schedule"}, {"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"kind": "photography", "event_kind": "deliverable_report", "doc_type": "photo_package", "proof_artifact_present": true, "content_hash": "sha256-photo-T1"}}, {"do": "send", "from": "external", "to": "12", "intent": "platform.metrics", "ctx": "T1", "payload": {"event_kind": "rejection", "platform": "facebook", "raw_rejection": "AD_REJECTED: housing category requires special ad category", "today": "2026-10-15"}}], "expect": [{"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains_all": ["platform_rejection", "AD_REJECTED: housing category"]}, {"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "never tweaking targeting"}]}
{"id": "12-03", "agent": "12", "tuple": "(engagement numbers conflict between sources, report both, named)", "route": "intake", "lines": [{"do": "config", "to": "14", "ctx": "T1", "payload": {"consent_record": {"email": "yes", "text": "yes"}}}, {"do": "authorize", "to": "05", "ctx": "T1", "payload": {"new_listing": {"address": "T1 Synthetic Ln, Testville, OH", "seller_name": "Seller T1-Synth", "beds": 3, "baths": 2, "sqft_tax_record": 1800, "price": 450000, "features": ["garage"]}, "authorize_go_live": true, "today": "2026-10-15"}}, {"do": "release", "ctx": "T1", "intent": "vendor.schedule"}, {"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"kind": "photography", "event_kind": "deliverable_report", "doc_type": "photo_package", "proof_artifact_present": true, "content_hash": "sha256-photo-T1"}}, {"do": "send", "from": "external", "to": "12", "intent": "platform.metrics", "ctx": "T1", "payload": {"platform": "facebook", "engagement_value": 40, "today": "2026-10-15"}}, {"do": "send", "from": "external", "to": "12", "intent": "platform.metrics", "ctx": "T1", "payload": {"platform": "zillow", "engagement_value": 55, "today": "2026-10-15"}}], "expect": [{"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains_all": ["engagement_conflict", "facebook", "zillow"]}, {"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "engagement numbers conflict"}], "note": "Agent 12 keys engagement by platform, so two platforms with different numbers count as a conflict, and the same platform reported twice overwrites the first figure. Listed as a finding."}
{"id": "12-04", "agent": "12", "tuple": "(CCP status unclear for a listing, no publish; the gate is hard)", "route": "intake", "lines": [{"do": "config", "to": "14", "ctx": "T1", "payload": {"consent_record": {"email": "yes", "text": "yes"}}}, {"do": "authorize", "to": "05", "ctx": "T1", "payload": {"new_listing": {"address": "T1 Synthetic Ln, Testville, OH", "seller_name": "Seller T1-Synth", "beds": 3, "baths": 2, "sqft_tax_record": 1800, "price": 450000, "features": ["garage"]}, "authorize_go_live": false, "today": "2026-10-15"}}, {"do": "release", "ctx": "T1", "intent": "vendor.schedule"}, {"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"kind": "photography", "event_kind": "deliverable_report", "doc_type": "photo_package", "proof_artifact_present": true, "content_hash": "sha256-photo-T1"}}], "expect": [{"kind": "spoke.trace", "agent": "12", "ctx": "T1", "contains": "held: ccp_gate"}, {"kind": "human.notified", "intent": "campaign.publish", "absent": true}, {"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains": "campaign_publish", "absent": true}], "note": "Go-live not authorized, so the MLS never confirms active and no exempt status is on file: the approved asset waits on the gate."}
{"id": "12-05", "agent": "12", "tuple": "(trending-topic tie-in idea, human approval first; reputational surface)", "route": "intake", "lines": [{"do": "config", "to": "12", "ctx": "T1", "payload": {"new_campaign": {"headline": "Open house Sunday", "body": "Bright kitchen near the park", "platform": "facebook", "trending_topic_tie_in": true}, "today": "2026-10-15"}}], "expect": [{"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "trending-topic tie-in"}, {"kind": "envelope.persisted", "intent": "content.review", "ctx": "T1", "absent": true}]}
