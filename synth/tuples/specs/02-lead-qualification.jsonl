{"id": "02-01", "agent": "02", "tuple": "(score lands on a tier boundary, assign the lower tier + flag for human)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Blake Edge-Synth", "phone": "(216) 555-0201", "budget": 450000, "timeline_days": 90, "financing_progress": "none"}}], "expect": [{"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "tier boundary"}, {"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains_all": ["\"tier\": \"COLD\"", "\"score\": 40"]}]}
{"id": "02-02", "agent": "02", "tuple": "(rubric version missing or unreadable, halt scoring; clarification - never score from memory of the rubric)", "route": "intake", "setup_skip": ["02"], "lines": [{"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Drew NoRubric-Synth", "phone": "(216) 555-0202", "budget": 500000, "timeline_days": 10}}], "expect": [{"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "no rubric active"}, {"kind": "escalation.raised", "ctx": "T1", "absent": true}], "note": "Setup without the signed rubric."}
{"id": "02-03", "agent": "02", "tuple": "(lead demands a human, hot path regardless of score)", "route": "none", "status": "NOT REACHABLE", "why": "No agent sets demands_human on a message to Agent 02; Agent 01 escalates a demand for a person itself (tuple 01-03). Owner decision pending (forwarding it would page twice)."}
{"id": "02-04", "agent": "02", "tuple": "(stated urgency conflicts with financing signals, weight verifiable financing over stated urgency; log the conflict)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Reese Rush-Synth", "phone": "(216) 555-0204", "stated_urgency": "high", "financing_progress": "none", "budget": 450000, "timeline_days": 60}}], "expect": [{"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains": "stated urgency 'high' conflicts with no financing progress"}]}
{"id": "02-05", "agent": "02", "tuple": "(a lead's tier oscillates a third time, human review; oscillation is a signal, not noise)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Osc Swing-Synth", "phone": "(216) 555-0205", "budget": 500000, "timeline_days": 10, "financing_progress": "preapproved"}}, {"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Osc Swing-Synth", "phone": "(216) 555-0205", "budget": 300000, "timeline_days": 90, "financing_progress": "none"}}, {"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Osc Swing-Synth", "phone": "(216) 555-0205", "budget": 500000, "timeline_days": 10, "financing_progress": "preapproved"}}], "expect": [{"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "oscillating a third time"}], "note": "Three inquiries on one context score HOT, COLD, HOT."}
{"id": "02-06", "agent": "02", "tuple": "(supplied rubric conflicts with a predeliberated tuple, the tuple wins; apply the tuple, record the conflict verbatim in the tier record, flag for human review; never silently pick either side - a surfaced conflict is a spec finding, a silent pick is drift)", "route": "intake", "setup_skip": ["02"], "lines": [{"do": "config", "to": "02", "ctx": "setup", "payload": {"rubric": {"budget_threshold": 400000, "budget_weight": 40, "timeline_days_threshold": 30, "timeline_weight": 40, "financing_weight": 20, "hot_threshold": 70, "warm_threshold": 40, "demands_human_weight": 0}, "version": "t-extra"}}], "expect": [{"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "setup", "contains": "keys outside what this agent's tuples allow"}], "note": "A signed rubric that tries to make a tuple behavior a scoring weight."}
{"id": "02-07", "agent": "02", "tuple": "(financing letter present but expired, treat as no financing verification; stated_by_party at best)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Parker Late-Synth", "phone": "(216) 555-0207", "budget": 500000, "timeline_days": 20, "financing_progress": "preapproved", "preapproval_doc": {"amount": 500000, "expired": true}}}], "expect": [{"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains_all": ["pre-approval letter expired", "\"score\": 80"]}]}
{"id": "02-08", "agent": "02", "tuple": "(lead is an agent shopping for a client, flag agent-to-agent; different track, human decides engagement)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Sage Agent-Synth", "phone": "(216) 555-0208", "is_agent_shopping": true, "budget": 700000, "timeline_days": 10, "financing_progress": "preapproved"}}], "expect": [{"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "agent-to-agent"}, {"kind": "escalation.raised", "ctx": "T1", "contains": "hot_lead", "absent": true}]}
{"id": "02-09", "agent": "02", "tuple": "(rubric update arrives unsigned, keep scoring on the last signed version; alert human; never adopt unsigned config)", "route": "intake", "lines": [{"do": "send", "from": "human", "to": "02", "intent": "config.update", "ctx": "setup", "payload": {"rubric": {"budget_threshold": 100, "budget_weight": 40, "timeline_days_threshold": 30, "timeline_weight": 40, "financing_weight": 20, "hot_threshold": 70, "warm_threshold": 40}, "version": "t-unsigned"}}, {"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Quinn After-Synth", "phone": "(216) 555-0209", "budget": 300000, "timeline_days": 90}}], "expect": [{"kind": "integrity.violation", "contains": "authority intent without verified signature"}, {"kind": "human.notified", "contains": "integrity.violation"}, {"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains_all": ["\"tier\": \"COLD\"", "\"rubric_version\": \"synth-v1\""]}], "note": "An unsigned rubric (budget threshold 100) is refused; the next lead is scored on the signed one."}
{"id": "02-10", "agent": "02", "tuple": "(lead's stated budget conflicts with pre-approval doc, doc wins for scoring; conflict logged verbatim)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Quinn Doc-Synth", "phone": "(216) 555-0210", "budget": 600000, "timeline_days": 20, "financing_progress": "preapproved", "preapproval_doc": {"amount": 350000}}}], "expect": [{"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains_all": ["conflicts with pre-approval doc amount 350000", "\"score\": 60"]}]}
{"id": "02-11", "agent": "02", "tuple": "(re-score request on a context with an open escalation, hold; the human's read outranks the rubric mid-escalation)", "route": "stand-in", "lines": [{"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Hot Open-Synth", "phone": "(216) 555-0211", "budget": 500000, "timeline_days": 10, "financing_progress": "preapproved"}}, {"do": "send", "from": "03", "to": "02", "intent": "lead.rescored", "ctx": "T1", "payload": {"budget": 300000, "timeline_days": 90, "financing_progress": "none", "today": "2026-10-15"}}], "expect": [{"kind": "escalation.raised", "contains": "escalation.hot_lead", "ctx": "T1"}, {"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "rescore during open escalation"}], "note": "Stand-in: Agent 03 re-scores only WARM leads in nurture, so a re-score of a HOT lead with an open escalation does not arise from intake; the runner sends it as Agent 03."}
{"id": "02-12", "agent": "02", "tuple": "(all rubric inputs unknown, tier is UNKNOWN not COLD; unknown is not a low score, it is absent data)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Drew Blank-Synth", "email": "drew.blank@example.test"}}], "expect": [{"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "all rubric inputs unknown"}, {"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains": "\"tier\": \"UNKNOWN\""}]}
{"id": "02-13", "agent": "02", "tuple": "(decision engine result is below the confidence floor, hold the lead for the broker; continue = score with the signed rubric and act on that tier, cancel = archive; never act on an uncertain tier)", "route": "intake", "lines": [{"do": "config", "to": "02", "ctx": "setup", "payload": {"decision_engine": {"confidence_floor": 0.9}}}, {"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Floor Held-Synth", "phone": "(216) 555-0213", "budget": 500000, "timeline_days": 10, "financing_progress": "preapproved"}}, {"do": "decide", "ctx": "T1", "decision": "continue"}], "expect": [{"kind": "envelope.persisted", "intent": "agent.status", "ctx": "T1", "contains": "below"}, {"kind": "escalation.raised", "contains": "escalation.hot_lead", "ctx": "T1"}], "note": "The local engine reports confidence 0.85; a signed floor of 0.9 holds the lead; the broker's continue scores it with the signed rubric (HOT)."}
{"id": "02-14", "agent": "02", "tuple": "(lead data would go to the live decision engine, only with a key set AND the broker's signed decision_engine.allow_external; a key alone sends nothing)", "route": "intake", "lines": [{"do": "config", "to": "02", "ctx": "setup", "payload": {"decision_engine": {"allow_external": true}}}, {"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Ext Off-Synth", "phone": "(216) 555-0214", "budget": 500000, "timeline_days": 10}}], "expect": [{"kind": "decision.lead", "ctx": "T1", "contains": "python_fallback"}], "note": "Signed allow_external with no key set: nothing is sent; the local engine scores."}
{"id": "02-15", "agent": "02", "tuple": "(decision engine returns a tier this agent does not recognize, treat it as below the floor and hold)", "route": "none", "status": "NOT REACHABLE", "why": "Needs a live decision engine that returns a tier Agent 02 does not know; this runner has no JEV key. The code path exists: listing_spokes_02.py _score turns any other tier into HELD_FOR_CALIBRATION, which holds the lead."}
{"id": "02-16", "agent": "02", "tuple": "(lead goes to nurture, send its scoring inputs with it so Lead Nurture can re-score it on the cadence)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "01", "intent": "lead.inbound", "ctx": "T1", "payload": {"channel": "web_form", "today": "2026-10-15", "consent": {"call": "yes", "text": "yes", "email": "yes"}, "name": "Warm Inputs-Synth", "phone": "(216) 555-0216", "budget": 500000, "timeline_days": 60, "financing_progress": "preapproved"}}], "expect": [{"kind": "envelope.persisted", "intent": "lead.nurture", "ctx": "T1", "contains_all": ["\"scoring_inputs\"", "\"timeline_days\": 60", "\"financing_progress\": \"preapproved\""]}]}
