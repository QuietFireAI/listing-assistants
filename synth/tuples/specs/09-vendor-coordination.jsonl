{"id": "09-01", "agent": "09", "tuple": "(vendor cancels late, notify 07/06 immediately + offer roster alternatives; regulated roles are never auto-rebooked without human)", "route": "intake", "lines": [{"do": "config", "to": "07", "ctx": "T1", "payload": {"timeline_init": {"inspection": "2026-10-25"}, "today": "2026-10-15"}}, {"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"event_kind": "cancellation", "kind": "inspector", "vendor_id": "v-insp-synthetic", "today": "2026-10-15"}}], "expect": [{"kind": "envelope.persisted", "intent": "vendor.cancellation_notice", "ctx": "T1", "count": 2}, {"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "never auto-rebooked"}, {"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "cancelled late"], "ctx": "T1"}]}
{"id": "09-02", "agent": "09", "tuple": "(credential expires mid-engagement, flag before any next scheduling)", "route": "intake", "lines": [{"do": "config", "to": "14", "ctx": "T1", "payload": {"consent_record": {"email": "yes", "text": "yes"}}}, {"do": "authorize", "to": "05", "ctx": "T1", "payload": {"new_listing": {"address": "T1 Synthetic Ln, Testville, OH", "seller_name": "Seller T1-Synth", "beds": 3, "baths": 2, "sqft_tax_record": 1800, "price": 450000, "features": ["garage"]}, "authorize_go_live": true, "today": "2028-01-15"}}], "expect": [{"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "v-photo-synthetic", "expired"], "ctx": "T1"}, {"kind": "envelope.persisted", "intent": "vendor.schedule", "ctx": "T1", "absent": true}], "note": "The roster's only photographer's license expired 2027-12-31; a listing signed on 2028-01-15 needs photos."}
{"id": "09-03", "agent": "09", "tuple": "(vendor proposes a rate change mid-job, halt + human; RESPA-adjacent territory)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"event_kind": "rate_change", "vendor_id": "v-photo-synthetic", "kind": "photography", "new_rate": 450}}], "expect": [{"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "rate change"], "ctx": "T1"}]}
{"id": "09-04", "agent": "09", "tuple": "(deliverable arrives partial, report partial truthfully; never mark collected)", "route": "intake", "lines": [{"do": "config", "to": "07", "ctx": "T1", "payload": {"timeline_init": {"inspection": "2026-10-25"}, "today": "2026-10-15"}}, {"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"event_kind": "deliverable_report", "kind": "inspector", "doc_type": "inspection_report", "proof_artifact_present": true, "partial": true}}], "expect": [{"kind": "envelope.persisted", "intent": "deliverable.release", "ctx": "T1", "contains": "\"partial\": true"}, {"kind": "envelope.persisted", "intent": "doc.status", "ctx": "T1", "contains": "partial"}, {"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains": "document_filed", "absent": true}]}
{"id": "09-05", "agent": "09", "tuple": "(two agents request the same vendor slot, deadline-driven request wins; ties go to human)", "route": "none", "status": "NOT REACHABLE", "why": "Agent 09 reads slot_key and deadline_priority on a vendor.request, and neither requester (Agent 05, Agent 07) sends them. A slot needs a vendor and an appointment time; no appointment date reaches Agent 09, and each roster vendor serves one kind, so two agents never ask for the same vendor. Owner decision: appointment dates and vendor capacity per slot."}
{"id": "09-06", "agent": "09", "tuple": "(vendor not on the approved list, refuse to schedule; propose addition to human; urgency does not create approval)", "route": "intake", "lines": [{"do": "config", "to": "07", "ctx": "T1", "payload": {"timeline_init": {"inspection": "2026-10-25"}, "today": "2026-10-15"}}], "expect": [{"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "no approved roster vendor for kind 'inspector'"}, {"kind": "envelope.persisted", "intent": "vendor.schedule", "ctx": "T1", "absent": true}], "note": "No inspector on the roster. Requesters never name a vendor, so the product form of 'not on the approved list' is no approved vendor of that kind."}
{"id": "09-07", "agent": "09", "tuple": "(vendor requests property access codes, custody protocol only; codes never ride vendor messages)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"event_kind": "access_code_request", "vendor_id": "v-photo-synthetic", "kind": "photography"}}], "expect": [{"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "access codes"], "ctx": "T1"}]}
{"id": "09-08", "agent": "09", "tuple": "(completion claimed without proof artifact, status stays open; deliverable.release requires the proof)", "route": "intake", "lines": [{"do": "config", "to": "14", "ctx": "T1", "payload": {"consent_record": {"email": "yes", "text": "yes"}}}, {"do": "authorize", "to": "05", "ctx": "T1", "payload": {"new_listing": {"address": "T1 Synthetic Ln, Testville, OH", "seller_name": "Seller T1-Synth", "beds": 3, "baths": 2, "sqft_tax_record": 1800, "price": 450000, "features": ["garage"]}, "authorize_go_live": true, "today": "2026-10-15"}}, {"do": "release", "ctx": "T1", "intent": "vendor.schedule"}, {"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"event_kind": "deliverable_report", "kind": "photography", "doc_type": "photo_package", "proof_artifact_present": false}}], "expect": [{"kind": "spoke.trace", "agent": "09", "ctx": "T1", "contains": "not released: no_proof"}, {"kind": "envelope.persisted", "intent": "deliverable.release", "ctx": "T1", "absent": true}]}
{"id": "09-09", "agent": "09", "tuple": "(invoice differs from quote, log both, human; never approve variances)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"event_kind": "invoice", "vendor_id": "v-photo-synthetic", "quote_amount": 300, "invoice_amount": 375}}], "expect": [{"kind": "envelope.persisted", "intent": "interaction.log", "ctx": "T1", "contains_all": ["invoice_variance", "300", "375"]}, {"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "differs from quote"], "ctx": "T1"}]}
{"id": "09-10", "agent": "09", "tuple": "(vendor no-show on a deadline-critical job, escalate + offer next approved vendor to human; never self-substitute)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"event_kind": "no_show", "vendor_id": "v-photo-synthetic", "kind": "photography", "deadline_critical": true, "today": "2026-10-15"}}], "expect": [{"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains_all": ["vendor no-show", "roster_alternatives"]}], "note": "Goes to the broker's queue with the roster alternatives (the clarification queue, not the escalation queue)."}
{"id": "09-11", "agent": "09", "tuple": "(work scope grows on-site per vendor, stop work order message per template; scope changes are human-approved)", "route": "intake", "lines": [{"do": "send", "from": "external", "to": "09", "intent": "vendor.event", "ctx": "T1", "payload": {"event_kind": "scope_change", "vendor_id": "v-photo-synthetic", "kind": "photography"}}], "note": "The stop-work message to the vendor is held for the broker's signed release (counterparty audience); it is not sent until then.", "expect": [{"kind": "absolute_signal.hold", "intent": "vendor.schedule"}, {"kind": "human.notified", "contains": "stop_work_order"}, {"kind": "envelope.persisted", "intent": "vendor.schedule", "ctx": "T1", "absent": true}, {"kind": "envelope.persisted", "intent": "clarification.request", "ctx": "T1", "contains": "scope changes are human-approved"}]}
