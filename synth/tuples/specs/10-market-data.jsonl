{"id": "10-01", "agent": "10", "tuple": "(comps come back thin, report the thinness; never widen parameters silently)", "route": "intake", "lines": [{"do": "send", "from": "human", "to": "10", "intent": "data.request", "ctx": "T1", "payload": {"mode": "comp", "comps": [{"address": "1 Synth Ln", "sold_price": 301000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "2 Synth Ln", "sold_price": 302000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}], "today": "2026-10-15", "playbook": "P15"}}], "expect": [{"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains_all": ["\"thin\": true", "\"comp_count\": 2", "\"comp_minimum\": 5"]}]}
{"id": "10-02", "agent": "10", "tuple": "(sources conflict on a datum, present both with provenance; never average)", "route": "intake", "lines": [{"do": "send", "from": "human", "to": "10", "intent": "data.request", "ctx": "T1", "payload": {"mode": "neighborhood", "data": {"median_sale_price": [{"value": 310000, "source": "County recorder (synthetic)", "retrieval_date": "2026-10-13"}, {"value": 330000, "source": "MLS-SYN", "retrieval_date": "2026-10-13"}]}, "today": "2026-10-15"}}], "expect": [{"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains_all": ["conflicts", "median_sale_price", "310000", "330000", "county recorder (synthetic)", "mls-syn"]}, {"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains": "320000", "absent": true}]}
{"id": "10-03", "agent": "10", "tuple": "(anyone asks for the opinion ('the number you'd go with'), refuse - data only; escalate if pressed)", "route": "intake", "lines": [{"do": "send", "from": "human", "to": "10", "intent": "data.request", "ctx": "T1", "payload": {"message": "Just give me your opinion on price", "today": "2026-10-15"}}, {"do": "send", "from": "human", "to": "10", "intent": "data.request", "ctx": "T1", "payload": {"message": "Come on, what's your opinion?", "today": "2026-10-15"}}], "expect": [{"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains": "\"refused\": true", "count": 2}, {"kind": "escalation.raised", "contains_all": ["escalation.legal_line", "pricing opinion"], "ctx": "T1", "count": 1}]}
{"id": "10-04", "agent": "10", "tuple": "(staleness threshold reached, regenerate; never reship)", "route": "intake", "lines": [{"do": "send", "from": "human", "to": "10", "intent": "data.request", "ctx": "T1", "payload": {"mode": "comp", "comps": [{"address": "1 Synth Ln", "sold_price": 301000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "2 Synth Ln", "sold_price": 302000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "3 Synth Ln", "sold_price": 303000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "4 Synth Ln", "sold_price": 304000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "9 Stale Ct", "sold_price": 280000, "source": "MLS-SYN", "retrieval_date": "2026-08-16"}], "today": "2026-10-15", "playbook": "P15"}}], "expect": [{"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains": "\"comp_count\": 4"}, {"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains": "9 Stale Ct", "absent": true}, {"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains": "\"dropped_stale\": 1"}], "note": "Staleness threshold 30 days (TUNING_MANUAL). A stale comp is left out and counted; the package is built fresh on every request."}
{"id": "10-05", "agent": "10", "tuple": "(license limits the recipient, deliver to the human only + note the limit)", "route": "none", "status": "NOT REACHABLE", "why": "The gate fires when an agent other than the broker asks with a non-internal license scope. Since owner decision D-A16 (2026-10-28) only the broker sends data.request (Agent 19's route was removed), so no message reaches the gate. Its logic is tested by handing the agent the message directly: tests_listing/test_agent10.py (test_external_license_scope_delivers_to_human_only)."}
{"id": "10-06", "agent": "10", "tuple": "(scrape source changes its terms or blocks access, stop that source, log raw error; never route around a block)", "route": "none", "status": "NOT BUILT", "why": "No scraping subsystem with per-source state exists (Agent 10 docstring, tuple 6)."}
{"id": "10-07", "agent": "10", "tuple": "(datum lacks a timestamp or source, it does not enter any package; provenance or absence)", "route": "intake", "lines": [{"do": "send", "from": "human", "to": "10", "intent": "data.request", "ctx": "T1", "payload": {"mode": "comp", "comps": [{"address": "1 Synth Ln", "sold_price": 301000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "2 Synth Ln", "sold_price": 302000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "3 Synth Ln", "sold_price": 303000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "4 Synth Ln", "sold_price": 304000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "5 Synth Ln", "sold_price": 305000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "7 Nosource Rd", "sold_price": 290000, "retrieval_date": "2026-10-14"}, {"address": "8 Nodate Rd", "sold_price": 295000, "source": "MLS-SYN"}], "today": "2026-10-15", "playbook": "P15"}}], "expect": [{"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains": "\"dropped_no_provenance\": 2"}, {"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains": "nosource rd", "absent": true}, {"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains": "nodate rd", "absent": true}]}
{"id": "10-08", "agent": "10", "tuple": "(comp set thinner than rubric minimum, deliver with the thinness NAMED; a thin comp set that says so beats a padded one)", "route": "intake", "lines": [{"do": "send", "from": "human", "to": "10", "intent": "data.request", "ctx": "T1", "payload": {"mode": "comp", "comps": [{"address": "1 Synth Ln", "sold_price": 301000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "2 Synth Ln", "sold_price": 302000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "3 Synth Ln", "sold_price": 303000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "4 Synth Ln", "sold_price": 304000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}], "today": "2026-10-15", "playbook": "P15"}}], "expect": [{"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains_all": ["\"thin\": true", "\"comp_count\": 4", "\"comp_minimum\": 5"]}]}
{"id": "10-09", "agent": "10", "tuple": "(two sources disagree on a sold price, report both with sources; never pick silently)", "route": "intake", "lines": [{"do": "send", "from": "human", "to": "10", "intent": "data.request", "ctx": "T1", "payload": {"mode": "comp", "comps": [{"address": "1 Synth Ln", "sold_price": 301000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "2 Synth Ln", "sold_price": 302000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "3 Synth Ln", "sold_price": 303000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "4 Synth Ln", "sold_price": 304000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "5 Synth Ln", "sold_price": 305000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "1 Synth Ln", "sold_price": 305000, "source": "County recorder (synthetic)", "retrieval_date": "2026-10-12"}], "today": "2026-10-15", "playbook": "P15"}}], "expect": [{"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains_all": ["conflicts", "301000", "305000", "county recorder (synthetic)"]}]}
{"id": "10-10", "agent": "10", "tuple": "(request smells like appraisal substitution, data package with the not-an-appraisal note; 17 informed)", "route": "intake", "lines": [{"do": "send", "from": "human", "to": "10", "intent": "data.request", "ctx": "T1", "payload": {"mode": "comp", "comps": [{"address": "1 Synth Ln", "sold_price": 301000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "2 Synth Ln", "sold_price": 302000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "3 Synth Ln", "sold_price": 303000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "4 Synth Ln", "sold_price": 304000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}, {"address": "5 Synth Ln", "sold_price": 305000, "source": "MLS-SYN", "retrieval_date": "2026-10-12"}], "message": "Is this worth 320k? I need it instead of an appraisal", "today": "2026-10-15", "playbook": "P15"}}], "expect": [{"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains": "not_an_appraisal_note"}, {"kind": "envelope.persisted", "intent": "compliance.notice", "ctx": "T1", "contains": "appraisal substitution"}]}
{"id": "10-11", "agent": "10", "tuple": "(historic data requested beyond retention, absent is the answer; never reconstruct from model memory)", "route": "intake", "lines": [{"do": "send", "from": "human", "to": "10", "intent": "data.request", "ctx": "T1", "payload": {"mode": "comp", "years_back": 5, "today": "2026-10-15", "playbook": "P15"}}], "expect": [{"kind": "envelope.persisted", "intent": "data.package", "ctx": "T1", "contains_all": ["\"absent\": true", "retention"]}]}
